{% extends "global_layout.jinja2" %}

{% block title %}{{ pathway.display_name }} Literature{% endblock %}

{% block head %}
<script>
    var pathway = {{ pathway_js|safe }};
</script>
{% endblock %}

{% block body %}

<!-- Tabs -->
<div class="row hide-for-small">
    <nav class="small-12 columns">
        <ul class="tabs sgd-tabs">
            <li id="summary_tab" class="tab-title"><a href="/pathway/{{ pathway.biocyc_id }}"><span>Summary</span></a></li>
            <li id="literature_tab" class="tab-title"><a href="/pathway/{{ pathway.biocyc_id }}/literature"><span>Literature</span></a></li>
        </ul>
        <div class="sgd-tab-shadow"></div>
    </nav>
</div>

<nav class="top-bar show-for-small mobile-tab-bar" data-topbar role="navigation">
        <ul class="title-area">
                <li class="name">
                   <h1><a>{{ pathway.biocyc_id }}</a></h1>
                </li>
                <li class="toggle-topbar"><a href="#"><span>&nbsp;<i class="fa fa-list-ul"></i></span></a></li>
        </ul>
        <section class="top-bar-section">
          <ul class="right">
            <li id="summary_tab" class="tab-title"><a href="/pathway/{{ pathway.biocyc_id }}"><span>Summary</span></a></li>
            <li id="literature_tab" class="tab-title"><a href="/pathway/{{ pathway.biocyc_id }}/literature"><span>Literature</span></a></li>
          </ul>
        </section>
</nav>

<script>document.getElementById("literature_tab").className += " active";</script>

<div class="row">

    {% include "navbar.jinja2" %}

    <div class="small-12 medium-10 columns content-column">

        <script>
            add_navbar_title('Pathway: <span class="gene_name">{{ pathway.display_name }}</span>')
            add_navbar_element('Literature', 'reference');
        </script>

<!-- References
================================================== -->
    <section id="reference" data-magellan-destination="reference">
        <div class="page-header">
            <h1>Literature
                <a href="#" data-dropdown="reference_help"><i class="fa fa-info-circle"></i></a>
                <p id="reference_help" class="f-dropdown content medium" data-dropdown-content>
                    Literature curated for this pathway.
                </p>
            </h1>
            <hr />
            {% if pathway.references|length > 0 %}
            <ul class="unstyled">
                {% for ref in pathway.references %}
                    <li>
                        <a href="{{ ref.link|e }}">{{ ref.display_name|e }}</a>
                        <span>{{ ref.citation|replace(ref.display_name, '')|safe }}</span>
                        {% if ref.pubmed_id != none %}
                            <small>PMID: {{ ref.pubmed_id|e }}</small>
                        {% endif %}
                        <ul class="ref-links">
                            <li><a href="{{ ref.link|e }}">SGD Paper</a></li>
                            {% for url in ref.urls %}
                                <li><a target="_infowin" href="{{ url.link|e }}">{{ url.display_name|e }}</a></li>
                            {% endfor %}
                        </ul>
                    </li>
                {% endfor %}
            </ul>
            {% else %}
            <p>No literature curated for this pathway.</p>
            {% endif %}
        </div>
    </section>

    </div>
</div>

{% endblock body %}
