{% extends "global_layout.jinja2" %}

{% block title %}Literature Recently Added to SGD{% endblock %}

{% block head %}

<script>
  var references = {{ references_js|safe }};
</script>

<style>
  #ref-facets-col { padding-top: 1rem; }
  .ref-facets-title { font-size: 1.1rem; font-weight: bold; margin-bottom: 0.5rem; }
  .ref-facet-clear-all { display: inline-block; margin-bottom: 0.75rem; font-size: 0.8rem; cursor: pointer; }
  .ref-facet { border-bottom: 1px solid #e0e0e0; padding: 0.4rem 0; }
  .ref-facet-header { cursor: pointer; font-weight: bold; font-size: 0.9rem;
      display: flex; justify-content: space-between; align-items: center; }
  .ref-facet-header .ref-facet-caret { color: #999; font-size: 0.8rem; }
  .ref-facet-body.collapsed { display: none; }
  .ref-facet-options { margin: 0.4rem 0 0.2rem 0; max-height: 16rem; overflow-y: auto; }
  .ref-facet-option { display: block; font-size: 0.82rem; line-height: 1.5;
      margin: 0; font-weight: normal; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ref-facet-option input[type="checkbox"] { margin: 0 0.5rem 0 0; vertical-align: middle; }
  .ref-facet-option .ref-facet-count { color: #888; }
  .ref-facet-filter { width: 100%; font-size: 0.8rem; padding: 0.2rem 0.3rem;
      margin-bottom: 0.3rem; height: auto; }
  .ref-facet-more { font-size: 0.78rem; cursor: pointer; color: #0072b9; display: inline-block; margin-top: 0.2rem; }
  #ref-result-count { font-size: 0.85rem; color: #555; margin-bottom: 0.75rem; }
</style>

{% endblock %}

{% block body %}

<!-- Navbar
================================================== -->
<div class="row">

    <!-- Facets sidebar -->
    <div id="ref-facets-col" class="small-12 medium-3 columns">
        <div class="ref-facets-title">Filter</div>
        <a class="ref-facet-clear-all" id="ref-facet-clear-all">Clear all filters</a>
        <div id="ref-facets"></div>
    </div>

    <div class="small-12 medium-9 columns content-column">

<!-- References
================================================== -->
        <section id="references" data-magellan-destination="references">
            <div class="page-header">
                <h1>Literature Recently Added to SGD</h1>
                <h2 class="subheader" id="dates"></h2><span id="references_header" class="label secondary round"></span></h2>
                <hr />
                <div id="ref-result-count"></div>
                {% set reference_list_id = "references_list" %}
                {% set empty_message = "No literature added recently." %}
                {% include "reference_list_with_entities.jinja2" %}
            </div>
        </section>
    </div>
</div>
{% endblock body %}

{% block scripts %}
<script src="{{asset_root}}/js/references_this_week.js"></script>
<script src="{{asset_root}}/js/references_facets.js"></script>
{% endblock scripts %}
